# Copy to .env and fill in. Nothing here is required to test the pipeline --
# it runs with zero keys using the placeholder image provider and espeak
# offline narration. Fill these in when you're ready for real output.

IMAGE_PROVIDER=placeholder      # placeholder | openai
TTS_PROVIDER=espeak             # espeak | openai | elevenlabs

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- performance / portability (see TERMUX.md) ---
SUPERSAMPLE=1.5        # Ken Burns sampling quality; 1.0 on a phone
FPS=25                 # 24 is slightly cheaper to encode
KEEP_BUILD=            # 1 to keep per-video intermediates for debugging
# FONT_BOLD=           # explicit .ttf path if none is auto-detected
# FONT_REGULAR=
