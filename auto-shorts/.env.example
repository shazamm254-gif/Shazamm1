# AUTO SHORTS runs with no configuration at all. Everything below is optional.
# Copy to .env and `source .env` only if you want to change a default.

# --- Server ---------------------------------------------------------------
# export PORT=5174
# export HOST=0.0.0.0
# export AUTOSHORTS_DATA="/path/to/where/projects/live"
# export AUTOSHORTS_MAX_UPLOAD=2147483648        # bytes per file (default 2 GB)
# export AUTOSHORTS_MAX_JOBS=2                   # concurrent renders

# --- FFmpeg ---------------------------------------------------------------
# A static build is installed by `npm install`, so this is only needed if you
# want to use a system FFmpeg instead.
# export AUTOSHORTS_FFMPEG=/usr/bin/ffmpeg
# export AUTOSHORTS_FFPROBE=/usr/bin/ffprobe

# --- Speech to text -------------------------------------------------------
# Without any of these, AUTO SHORTS aligns the script you paste against the
# speech it detects in your audio. That needs no model and no network.
#
# For true word-level transcription, install Whisper and it is used
# automatically:
#   pip install openai-whisper        -> nothing else to set
#   pip install faster-whisper        -> set AUTOSHORTS_WHISPER_MODEL=base
#   whisper.cpp                       -> set both of the below
# export AUTOSHORTS_WHISPER_BIN=/usr/local/bin/whisper-cli
# export AUTOSHORTS_WHISPER_MODEL=/models/ggml-base.en.bin
# export AUTOSHORTS_STT_PROVIDER=auto            # auto | whisper | script-align | srt
# export AUTOSHORTS_STT_LANG=en

# --- AI analysis ----------------------------------------------------------
# The default provider is `local`: deterministic heuristics, no key, no network,
# no per-video cost. Setting a key below enables a hosted provider that refines
# word emphasis and B-roll intent. Only the transcript is ever sent — your media
# never leaves the machine — and if the call fails the edit falls back to local.
# export ANTHROPIC_API_KEY="sk-ant-..."
# export AUTOSHORTS_ANTHROPIC_MODEL="claude-sonnet-5"
# export OPENAI_API_KEY="sk-..."
# export AUTOSHORTS_OPENAI_MODEL="gpt-4o-mini"
# export AUTOSHORTS_AI_PROVIDER=auto             # auto | local | anthropic | openai
